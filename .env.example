# Docker Compose database configuration
DB_USER=invoiceadmin
DB_PASSWORD=invoice@Pass123
DB_NAME=invoicedb
DB_PORT=5432
DB_HOST=postgres

# Security & Tokens
JWT_SECRET=super-secret-jwt-key-change-in-prod
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@invoiceplatform.com
SMTP_PASS=changeme

# Runtime ports exposed on the Docker host
FRONTEND_PORT=80
API_GATEWAY_PORT=8080

# Frontend build configuration. Leave empty to use the frontend Nginx API proxy.
VITE_API_BASE_URL=

# AI OCR configuration
# Use "local" to process invoices with bundled libraries, or "simulation" for demo data.
OCR_ENGINE=local
OCR_LANGUAGE=eng
OCR_FALLBACK_TO_SIMULATION=true

# Optional Gemini fraud explanation enhancer
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Service configuration
CORS_ORIGIN=http://localhost
LOG_LEVEL=info
